{
  "rules": [
    {
      "allowed": {
        "origins": [
          "https://energiaprospectar.com.br",
          "https://www.energiaprospectar.com.br",
          "http://localhost:3000"
        ],
        "methods": ["GET", "PUT", "HEAD"],
        "headers": ["Content-Type", "x-amz-*"]
      },
      "exposeHeaders": ["ETag"],
      "maxAgeSeconds": 3600
    }
  ]
}
